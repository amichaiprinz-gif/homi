{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-push",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-push",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 14 * * *"
    }
  ]
}
